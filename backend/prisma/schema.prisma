generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  CONTENT_MANAGER
  MODERATOR
  SUPER_ADMIN
}

enum ReportStatus {
  PENDING
  RESOLVED
  REJECTED
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String

  resetToken       String?
  resetTokenExpiry DateTime?

  role         Role      @default(USER)
  isActive     Boolean   @default(true)
  bio          String?
  profileImage String?
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  posts    Post[]
  comments Comment[]
  likes    Like[]

  followers Follow[] @relation("followers")
  following Follow[] @relation("following")

  reports         Report[]
  supportMessages SupportMessage[]

  notifications      Notification[]
  welcomeEmailOutbox WelcomeEmailOutbox?

  chatConversationsAsFirst  ChatConversation[]    @relation("ChatConversationFirstUser")
  chatConversationsAsSecond ChatConversation[]    @relation("ChatConversationSecondUser")
  chatMessages              ChatMessage[]         @relation("ChatMessageSender")
  chatMessageDeletions      ChatMessageDeletion[]
}

model WelcomeEmailOutbox {
  id            Int       @id @default(autoincrement())
  userId        Int       @unique
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lockedAt      DateTime?
  sentAt        DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sentAt, nextAttemptAt, lockedAt])
}

model ChatConversation {
  id            Int      @id @default(autoincrement())
  firstUserId   Int
  secondUserId  Int
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  firstUser  User          @relation("ChatConversationFirstUser", fields: [firstUserId], references: [id], onDelete: Cascade)
  secondUser User          @relation("ChatConversationSecondUser", fields: [secondUserId], references: [id], onDelete: Cascade)
  messages   ChatMessage[]

  @@unique([firstUserId, secondUserId])
  @@index([firstUserId, lastMessageAt])
  @@index([secondUserId, lastMessageAt])
}

model ChatMessage {
  id             Int       @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String?
  image          String?
  deliveredAt    DateTime?
  readAt         DateTime?
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  conversation ChatConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                  @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  hiddenFor    ChatMessageDeletion[]

  @@index([conversationId, createdAt])
  @@index([conversationId, readAt])
}

model ChatMessageDeletion {
  messageId Int
  userId    Int
  deletedAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, deletedAt])
}

model Post {
  id                Int     @id @default(autoincrement())
  content           String
  image             String?
  video             String?
  mediaPublicId     String?
  mediaResourceType String?
  category          String?
  hashtags          String?
  location          String?

  visibility      PostVisibility @default(PUBLIC)
  commentsEnabled Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  comments Comment[]
  likes    Like[]
  reports  Report[]

  notifications Notification[]
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())

  userId Int
  postId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Like {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  userId Int
  postId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Follow {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  followerId  Int
  followingId Int

  follower  User @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Report {
  id        Int          @id @default(autoincrement())
  reason    String
  response  String?
  status    ReportStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  reporterId Int
  postId     Int

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([reporterId, postId])
}

model SupportMessage {
  id        Int      @id @default(autoincrement())
  message   String
  reply     String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  message   String
  postId    Int?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id         Int           @id @default(autoincrement())
  name       String
  email      String
  subject    String
  message    String
  adminReply String?
  status     ContactStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

enum ContactStatus {
  PENDING
  REPLIED
}
